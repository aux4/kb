{
  "scope": "aux4",
  "name": "kb",
  "version": "0.1.11",
  "description": "aux4 knowledge base manager",
  "license": "Apache-2.0",
  "git": "https://github.com/aux4/kb",
  "tags": [
    "aux4",
    "kb",
    "knowledge",
    "markdown"
  ],
  "system": [
    [
      "test:node --version",
      "brew:node",
      "linux:nodejs"
    ]
  ],
  "profiles": [
    {
      "name": "main",
      "commands": [
        {
          "name": "kb",
          "execute": [
            "profile:kb"
          ],
          "help": {
            "text": "aux4 knowledge base manager"
          }
        }
      ]
    },
    {
      "name": "kb",
      "commands": [
        {
          "name": "add",
          "execute": [
            "node ${packageDir}/lib/aux4-kb.mjs add values(folder, topic, content, file, tags, page, section)"
          ],
          "help": {
            "text": "Add a new knowledge entry",
            "variables": [
              {
                "name": "topic",
                "text": "Topic title",
                "arg": true
              },
              {
                "name": "folder",
                "text": "Knowledge base folder path",
                "default": ".knowledge"
              },
              {
                "name": "content",
                "text": "Markdown content",
                "default": ""
              },
              {
                "name": "file",
                "text": "Path to markdown file for content",
                "default": ""
              },
              {
                "name": "tags",
                "text": "Comma-separated tags",
                "default": ""
              },
              {
                "name": "page",
                "text": "Page (subfolder) to add the block to; the block is linked into the page spine (index.md)",
                "default": ""
              },
              {
                "name": "section",
                "text": "Section heading in the page spine to append the block link under (created if absent)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "update",
          "execute": [
            "node ${packageDir}/lib/aux4-kb.mjs update values(folder, topic, content, file)"
          ],
          "help": {
            "text": "Update an existing knowledge entry",
            "variables": [
              {
                "name": "topic",
                "text": "Topic title",
                "arg": true
              },
              {
                "name": "folder",
                "text": "Knowledge base folder path",
                "default": ".knowledge"
              },
              {
                "name": "content",
                "text": "New markdown content",
                "default": ""
              },
              {
                "name": "file",
                "text": "Path to markdown file for content",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "remove",
          "execute": [
            "node ${packageDir}/lib/aux4-kb.mjs remove values(folder, topic)"
          ],
          "help": {
            "text": "Remove a knowledge entry",
            "variables": [
              {
                "name": "topic",
                "text": "Topic title",
                "arg": true
              },
              {
                "name": "folder",
                "text": "Knowledge base folder path",
                "default": ".knowledge"
              }
            ]
          }
        },
        {
          "name": "search",
          "execute": [
            "node ${packageDir}/lib/aux4-kb.mjs search values(folder, query)"
          ],
          "help": {
            "text": "Search the knowledge base",
            "variables": [
              {
                "name": "query",
                "text": "Search query",
                "arg": true
              },
              {
                "name": "folder",
                "text": "Knowledge base folder path",
                "default": ".knowledge"
              }
            ]
          }
        },
        {
          "name": "list",
          "execute": [
            "node ${packageDir}/lib/aux4-kb.mjs list values(folder)"
          ],
          "help": {
            "text": "List all knowledge base entries",
            "variables": [
              {
                "name": "folder",
                "text": "Knowledge base folder path",
                "default": ".knowledge"
              }
            ]
          }
        },
        {
          "name": "view",
          "execute": [
            "node ${packageDir}/lib/aux4-kb.mjs view values(folder, topic)"
          ],
          "help": {
            "text": "View a knowledge base entry",
            "variables": [
              {
                "name": "topic",
                "text": "Topic title",
                "arg": true
              },
              {
                "name": "folder",
                "text": "Knowledge base folder path",
                "default": ".knowledge"
              }
            ]
          }
        },
        {
          "name": "page",
          "execute": [
            "node ${packageDir}/lib/aux4-kb.mjs page values(folder, page)"
          ],
          "help": {
            "text": "Assemble and print a page from its spine (index.md), inlining each block",
            "variables": [
              {
                "name": "page",
                "text": "Page path to assemble (may be nested, e.g. form-engine/realtime)",
                "arg": true
              },
              {
                "name": "folder",
                "text": "Knowledge base folder path",
                "default": ".knowledge"
              }
            ]
          }
        },
        {
          "name": "move",
          "execute": [
            "node ${packageDir}/lib/aux4-kb.mjs move values(folder, topic, page, section)"
          ],
          "help": {
            "text": "Relocate an existing entry into a page (subfolder), updating the spines and index",
            "variables": [
              {
                "name": "topic",
                "text": "Topic title of the entry to move",
                "arg": true
              },
              {
                "name": "folder",
                "text": "Knowledge base folder path",
                "default": ".knowledge"
              },
              {
                "name": "page",
                "text": "Target page path to move the entry into (may be nested, e.g. a/b/c)",
                "default": ""
              },
              {
                "name": "section",
                "text": "Section heading in the target page spine to append the block link under (default: Blocks)",
                "default": ""
              }
            ]
          }
        },
        {
          "name": "reindex",
          "execute": [
            "node ${packageDir}/lib/aux4-kb.mjs reindex values(folder)"
          ],
          "help": {
            "text": "Rebuild index.json to match the markdown files on disk (non-destructive)",
            "variables": [
              {
                "name": "folder",
                "text": "Knowledge base folder path",
                "default": ".knowledge"
              }
            ]
          }
        },
        {
          "name": "links",
          "execute": [
            "node ${packageDir}/lib/aux4-kb.mjs links values(folder, from, to, orphans, missing, render)"
          ],
          "help": {
            "text": "Show links between knowledge base entries",
            "variables": [
              {
                "name": "folder",
                "text": "Knowledge base folder path",
                "default": ".knowledge"
              },
              {
                "name": "from",
                "text": "Show outbound links from this topic",
                "default": ""
              },
              {
                "name": "to",
                "text": "Show inbound links (backlinks) to this topic",
                "default": ""
              },
              {
                "name": "orphans",
                "text": "Show pages with no inbound links",
                "default": "false"
              },
              {
                "name": "missing",
                "text": "Show linked pages that do not exist",
                "default": "false"
              },
              {
                "name": "render",
                "text": "Output format (text or json)",
                "default": "text",
                "options": [
                  "text",
                  "json"
                ]
              }
            ]
          }
        },
        {
          "name": "refs",
          "execute": [
            "node ${packageDir}/lib/aux4-kb.mjs refs values(folder, topic, render)"
          ],
          "help": {
            "text": "List references from a page to other pages",
            "variables": [
              {
                "name": "topic",
                "text": "Topic title",
                "arg": true
              },
              {
                "name": "folder",
                "text": "Knowledge base folder path",
                "default": ".knowledge"
              },
              {
                "name": "render",
                "text": "Output format (text or json)",
                "default": "text",
                "options": [
                  "text",
                  "json"
                ]
              }
            ]
          }
        },
        {
          "name": "backrefs",
          "execute": [
            "node ${packageDir}/lib/aux4-kb.mjs backrefs values(folder, topic, render)"
          ],
          "help": {
            "text": "List pages that reference a given page",
            "variables": [
              {
                "name": "topic",
                "text": "Topic title",
                "arg": true
              },
              {
                "name": "folder",
                "text": "Knowledge base folder path",
                "default": ".knowledge"
              },
              {
                "name": "render",
                "text": "Output format (text or json)",
                "default": "text",
                "options": [
                  "text",
                  "json"
                ]
              }
            ]
          }
        },
        {
          "name": "graph",
          "execute": [
            "node ${packageDir}/lib/aux4-kb.mjs graph values(folder, topic, render)"
          ],
          "help": {
            "text": "Generate a mermaid graph of page references",
            "variables": [
              {
                "name": "topic",
                "text": "Topic title (optional, generates graph for specific page)",
                "arg": true,
                "default": ""
              },
              {
                "name": "folder",
                "text": "Knowledge base folder path",
                "default": ".knowledge"
              },
              {
                "name": "render",
                "text": "Output format (text or json)",
                "default": "text",
                "options": [
                  "text",
                  "json"
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
